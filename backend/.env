# Database Configuration (using PostgreSQL)
# For local development, you can use a local PostgreSQL instance
# For production, use Supabase, Railway, or other PostgreSQL hosting
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sih2026?schema=public"

# Server Configuration
PORT=3001
NODE_ENV=development

# Sentinel Hub / Satellite Imagery API
# Get your free API key from: https://www.sentinel-hub.com/
SENTINEL_HUB_API_KEY=""
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""

# OpenWeather API
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=""

# CORS Configuration
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# JWT Secret (if implementing authentication)
JWT_SECRET="dev-secret-key-change-in-production"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="debug"
