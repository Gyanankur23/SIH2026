# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/sih2026?schema=public"

# Server Configuration
PORT=3001
NODE_ENV=development

# Sentinel Hub / Satellite Imagery API
SENTINEL_HUB_API_KEY="your_sentinel_hub_api_key"
SENTINEL_HUB_CLIENT_ID="your_sentinel_hub_client_id"
SENTINEL_HUB_CLIENT_SECRET="your_sentinel_hub_client_secret"

# OpenWeather API
OPENWEATHER_API_KEY="your_openweather_api_key"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# JWT Secret (if implementing authentication)
JWT_SECRET="your_jwt_secret_key"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"
