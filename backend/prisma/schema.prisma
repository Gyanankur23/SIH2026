generator client {
  provider = "prisma-client-js"
}

generator typescript {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Farmer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  plots     Plot[]

  @@index([email])
}

model Officer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  region    String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Plot {
  id           String   @id @default(cuid())
  name         String
  farmerId     String
  farmer       Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  location     String
  coordinates  Json     // Store polygon coordinates as GeoJSON
  cropType     String
  area         Float    // in hectares
  soilType     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  alerts       Alert[]
  historicalData HistoricalData[]

  @@index([farmerId])
  @@index([cropType])
}

model Alert {
  id           String   @id @default(cuid())
  plotId       String
  plot         Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)
  type         String
  severity     String   // low, medium, high, critical
  message      String
  recommendation String
  ndvi         Float?
  timestamp    DateTime @default(now())
  resolved     Boolean  @default(false)
  resolvedAt   DateTime?

  @@index([plotId])
  @@index([severity])
  @@index([timestamp])
}

model HistoricalData {
  id           String   @id @default(cuid())
  plotId       String
  plot         Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)
  date         DateTime
  ndvi         Float
  rainfall     Float?
  temperature  Float?
  humidity     Float?
  satelliteProvider String? // sentinel-2, landsat, etc.
  imageUrl     String?
  createdAt    DateTime @default(now())
  
  @@unique([plotId, date])
  @@index([plotId])
  @@index([date])
}

enum CropType {
  WHEAT
  RICE
  COTTON
  SUGARCANE
  SOYBEAN
  MAIZE
  TOMATO
  POTATO
  OTHER
}

enum AlertType {
  MOISTURE_STRESS
  WEATHER_ALERT
  NUTRIENT_DEFICIENCY
  PEST_INFESTATION
  DISEASE_RISK
  GROWTH_ANOMALY
  FLOOD_RISK
  DROUGHT_RISK
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
