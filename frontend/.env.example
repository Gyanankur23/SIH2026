# API Configuration
VITE_API_URL="http://localhost:3001/api"
VITE_API_TIMEOUT=30000

# Map Configuration
VITE_DEFAULT_MAP_CENTER_LAT="20.0"
VITE_DEFAULT_MAP_CENTER_LNG="73.79"
VITE_DEFAULT_MAP_ZOOM="7"

# Application Configuration
VITE_APP_NAME="CropGuard"
VITE_APP_VERSION="1.0.0"

# Feature Flags
VITE_ENABLE_DEMO_MODE="true"
VITE_ENABLE_WEATHER_ALERTS="true"
VITE_ENABLE_SATELLITE_IMAGERY="true"

# Rate Limiting
VITE_API_RATE_LIMIT="100"
