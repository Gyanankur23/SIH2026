{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/health",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "env": {
    "DATABASE_URL": "@database_url",
    "OPENWEATHER_API_KEY": "@openweather_api_key",
    "SENTINEL_HUB_API_KEY": "@sentinel_hub_api_key",
    "SENTINEL_HUB_CLIENT_ID": "@sentinel_hub_client_id",
    "SENTINEL_HUB_CLIENT_SECRET": "@sentinel_hub_client_secret",
    "NODE_ENV": "production"
  }
}
